# Obtain an API key from https://aistudio.google.com/apikey
# Never prefix this with NEXT_PUBLIC_. Never commit a real secret.
GEMINI_API_KEY=
# Stable model listed in Google's October 2026 Gemini API documentation.
GEMINI_MODEL=gemini-3.8-flash
# Highly recommended on a publicly accessible Vercel demo to discourage quota abuse.
# Enter the same code in the Analyze page; leave blank only for local testing.
DEMO_ACCESS_CODE=

# ProofMatch Connect: OPTIONAL shared reply storage (not required for browser-only demo)
# Connect Upstash Redis REST API to sync fictional replies between phone and recruiter laptop.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REAL Telegram opt-in bot. All three must be set, plus Upstash and DEMO_ACCESS_CODE above.
# Register the webhook after deployment using npm run telegram:setup -- https://YOUR_SITE.vercel.app
# Bots cannot initiate a private conversation before a user opens/starts the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Real Telegram delivery of scheduled fictional LiveRoom invitations
# HTTPS URL for your deployed ProofMatch site, e.g. https://your-proofmatch.vercel.app
PROOFMATCH_PUBLIC_URL=
# Create a private random code (8–40 letters/digits/underscores/dashes).
# Use the private pairing link once from YOUR Telegram account; never publish this code.
TELEGRAM_DEMO_PAIRING_CODE=
